# Required in production. Railway can inject either variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# FANTASY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional: transactional team invitation email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Scribner Draft <draft@example.com>

# Local/temporary production-like runs only. Do not use for a deployed multi-user draft.
# SCRIBNER_ALLOW_JSON_STORAGE=true
