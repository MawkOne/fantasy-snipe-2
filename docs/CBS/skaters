<script>

    var leagueInfo = {
        "league_id": "uhhp",
        "league_uses_waivers": 0,
        "is_commissioner": 1,
        "league_uses_faab": 1
    };
    var leagueId = leagueInfo.league_id;
    var isCommissioner = leagueInfo.is_commissioner;
    var leagueUsesWaivers = leagueInfo.league_uses_waivers;
    var leagueUsesFaab = leagueInfo.league_uses_faab;
    var waiversType = "FAB";
    var startWaiversCookie = "shown_start_waivers_modal";
    function setCookie(cookieName, value, expInDays) {
        var expDate = new Date();
        expDate.setDate(expDate.getDate() + expInDays);
        var cookieValue = value + ((expInDays == null) ? "" : "; expires=" + expDate.toUTCString());
        document.cookie = cookieName + "=" + cookieValue;
    }
    ;
    // from media/htdocs/nfl/gametracker/gclps.js     
    function getOrdinal(num) {
        if (isNaN(num)) {
            return num;
        } else {
            var ordinal;
            var remainder = num % 100;
            switch (remainder) {
            case 1:
                ordinal = num + 'st';
                break;
            case 2:
                ordinal = num + 'nd';
                break;
            case 3:
                ordinal = num + 'rd';
                break;
            case 11:
            case 12:
            case 13:
            default:
                ordinal = num + 'th';
            }
            return ordinal;
        }

    }
    function applyModalStyles() {
        $(".ui-dialog-titlebar").css({
            'backgroundColor': '#0055a6',
            'color': 'white'
        });
        $(".ui-dialog").css({
            'border': 'none'
        });
        $('a.ui-dialog-titlebar-close').css({
            'color': 'white'
        }).hover(function(e) {
            $(this).css('color', e.type === 'mouseenter' ? '#3787d9' : 'white');
        });
    }

    function displayConfirmationModal(startDate) {

        var modalOptions = {
            dialogClass: "help-dialog",
            width: 540,
            modal: "true",
            title: waiversType === 'FAAB' ? "YOUR LEAGUE'S FAB PROCESS HAS STARTED" : "YOUR LEAGUE'S WAIVERS HAVE STARTED"

        };
        var convertedStartDate = new Date(startDate.replace(/(\d{4})(\d{2})(\d{2})/, "$2/$3/$1"));
        var startMonth = convertedStartDate.toLocaleString("en-us", {
            month: "long"
        });
        var startDay = getOrdinal(Number(convertedStartDate.getDate()));
        var confirmedStartDate = startMonth + " " + startDay;
        var confirmedResponseModal = "<div style='display:flex; flex-direction: column; justify-content: start; align-items:center; font-size: 14px;' id='responseModal'><span style='text-align: center;'>Your first " + waiversType + " run will occur on <b style='font-size: 14px;'>" + confirmedStartDate + "</b> at approximately 2AM ET in accordance with your league's transaction policies. An email has been sent to all members in your league to inform them of the start date.</span> <button id='okButton' style='width: auto; margin-top: 30px; padding: 10px 40px 10px 40px;' class='btn-primary'>OK</button>";

        $('#initialModal').dialog("destroy");
        $(confirmedResponseModal).dialog(modalOptions).dialog("open");
        applyModalStyles();
        $('#okButton').click(function() {
            $('#responseModal').dialog("destroy");
        });

    }

    $(document).ready(function() {

        var initialModal = "<div style='display:flex; flex-direction: column; justify-content: start; align-items:center; font-size: 14px;' id='initialModal'><span style='text-align: center;' id='waiversModalText'>Congratulations on completing your league's draft. The next step for your league is to start " + waiversType + ". Please select one of the options below.</span> <button style='width:auto; margin-top: 30px;'id='startImmediatelyButton' class='btn-primary'>Start " + waiversType + " Immediately</button><a href='/setup/commish-tools/transactions/start-" + waiversType.toLowerCase() + "' style='margin-top: 20px; font-weight: 600; color:#3787d9; font-size: 16px;'>Select a later date</a></div>";

        var sessionBasedModal = "<div style='display:flex; flex-direction: column; justify-content: start; align-items:center; font-size: 14px;' id='initialModal'><span style='text-align: center;' id='waiversModalText'>The start of the season is approaching and your league's " + waiversType + " process has not started. Please select one of the options below. Please select one of the options below</span> <button style='width:auto; margin-top: 30px;'id='startImmediatelyButton' class='btn-primary'>Start " + waiversType + " Immediately</button><a href='/setup/commish-tools/transactions/start-" + waiversType.toLowerCase() + "' style='margin-top: 20px; font-weight: 600; color:#3787d9; font-size: 16px;'>Select a later date</a></div>";

        var options = {
            dialogClass: "help-dialog",
            width: 540,
            modal: "true",
            title: waiversType === 'FAB' ? "START YOUR LEAGUE'S FAB PROCESS" : "START YOUR LEAGUE'S WAIVERS"

        };

        if (isCommissioner && (leagueUsesWaivers || leagueUsesFaab)) {
            var shouldStartWaivers = false;
            var seasonStartDate = '';
            $.ajax({
                url: '/api/league/transactions/waiver-status',
                method: 'GET',
                dataType: 'json',
                data: {
                    response_format: 'json',
                    league_id: leagueId,
                    version: '3.0',
                },
            }).done(function(response) {
                if (response.error) {
                    console.error('Error ' + error);
                } else {

                    if (response && response.body && response.body.waiver_status) {

                        shouldStartWaivers = response.body.waiver_status.need_to_start_waivers;
                        seasonStartDate = response.body.waiver_status.season_start_date;

                    }
                    if (shouldStartWaivers && !readCookie(startWaiversCookie)) {
                        // convert today's date to YYYYMMDD format
                        var todaysDate = new Date().toISOString().slice(0, 10).replace(/-/g, "");
                        var daysUntilSeasonStarts = Number(seasonStartDate) - Number(todaysDate);

                        if (daysUntilSeasonStarts > 3) {
                            setCookie(startWaiversCookie, "true", daysUntilSeasonStarts - 3);
                            $(initialModal).dialog(options).dialog("open");
                            applyModalStyles();

                        } else if (daysUntilSeasonStarts >= 0 && daysUntilSeasonStarts <= 3) {
                            $(sessionBasedModal).dialog(options).dialog("open");
                            applyModalStyles();
                            setCookie(startWaiversCookie, "true");
                        }
                        $('#startImmediatelyButton').click(function() {
                            $(this).prop('disabled', true);
                            var params = {
                                access_token: CBSi.token,
                                response_format: 'json',
                                league_id: leagueId,
                                version: '3.0',
                                payload: JSON.stringify({
                                    empty: 1
                                }),
                            };
                            Waldo.retrieve({
                                uri: '/api/league/transactions/start-waivers',
                                params: params,
                                type: 'PUT',
                                callback: {
                                    success: function() {
                                        var response = this.data();
                                        var startDate = response && response.start_waivers && response.start_waivers.start_date;
                                        displayConfirmationModal(startDate);
                                    },
                                    failure: function() {
                                        console.log('error', this);
                                    }
                                }
                            });
                        });

                    }
                }
            });
        }
    });
</script>
