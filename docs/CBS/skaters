<script>

    function gambling_tracking() {
        var trackingImage;
        $('a.william-hill-link').each(function() {
            var omAction = $(this).attr("om-action");
            if (typeof omAction !== 'undefined') {
                $(this).attr("om-action", omAction.replace(/}/, ',"elAfAd":"' + surround.vguid + '"}'));
                if (typeof utag_data !== "undefined") {
                    $(this).attr("om-action", omAction.replace(/pageName/, utag_data.pageName));
                }
            }
            var href = $(this).data('wh-url');
            $(this).attr("href", href.replace(/#vguid#|#VGUID#/g, surround.vguid));
            var oneByOneUrl = $(this).data('wh-tracking-image');
            if (oneByOneUrl && !trackingImage) {
                var timestamp = Date.now() || +new Date();
                var replacementObj = {
                    "#vguid#": surround.vguid,
                    "#timestamp#": timestamp
                };
                oneByOneUrl = oneByOneUrl.replace(/#vguid#|#VGUID#|#timestamp#|#TIMESTAMP#/gi, function(match) {
                    return replacementObj[match.toLowerCase()];
                });
                trackingImage = '<img src=' + oneByOneUrl + ' style="height: 1px; width: 1px;" border="0" alt="Advertisement" >';
                $('body').append(trackingImage);
            }
        });
    }

    function gambling_tracking_impressions(isFullPageLoad) {
        var trackTitle = '';
        var trackImpressionObj = {};
        $('a.william-hill-link').each(function() {
            var trackImpression = $(this).data('wh-tracking-impression');
            if (trackImpression) {
                if (typeof utag_data !== "undefined" && typeof trackImpression.moduleLocation !== "undefined" && trackImpression.moduleLocation == 'pageName') {
                    trackImpression.moduleLocation = utag_data.pageName;
                }
                if (isFullPageLoad || trackImpression.moduleName != 'cbs-network-bar') {
                    if (trackTitle == '') {
                        trackTitle = trackImpression.moduleName;
                        trackImpressionObj = JSON.parse(JSON.stringify(trackImpression));
                        // don't add duplicates
                    } else if (trackTitle.indexOf(trackImpression.moduleName) == -1) {
                        trackTitle += ";" + trackImpression.moduleName;
                        trackImpressionObj.moduleName += ";" + trackImpression.moduleName;
                    }
                }
            }
        });
        if (trackTitle != '' && typeof om !== "undefined") {
            om.trackAction(trackTitle, trackImpressionObj);
            if (typeof utag_data !== "undefined") {
                // clear data so it doesn't get sent in subsequent calls
                utag_data.moduleName = '';
                utag_data.moduleLocation = '';
                utag_data.moduleAction = '';
                utag_data.moduleCampaign = '';
            }
        }
    }

    $(document).ready(function() {
        gambling_tracking();
    });
    $(window).on("load", function() {
        gambling_tracking_impressions(1);
    });
</script>
