<script>
    var AddDropPanel = function(args) {
        this.panelToShow = "transactionDetails";
        this.alreadyLoadedTransactionDetails = 0;
        this.alreadyLoadedPendingAddDrops = 0;
        this.playerToAddId = "";
        this.playerToDropId = "";
        this.playerToAddPos = "";
        this.numPendingAddDrops = 0;
        this.leagueId = "";
        this.sport = "";
        this.bidAmount = "";
        this.comment = "";
        this.dropAction = "";
        this.dropState = "";
        this.addDropTransId = "";
        this.primaryTab = "";
        this.secondaryTab = "";
        this.sourceId = "";
        this.isRosterShown = 0;
        this.haveButtonsLoaded = 0;
        this.accessToken = "";
        this.openOffset = 118;
        this.leagueUsesWaivers = 0;
        this.leagueAddDropPolicy = "";
        this.editAddDrop = 0;
        this.loadTransactionDetailsInBackground = 0;
        this.initialAlertMessage = "";
        this.shouldDisable = 0;
        this.disabledMessage = "";
        this.defaultAddPlayer = 0;
        this.smallPanelHeight = 300;
        this.containerZIndex = 0;
        this.init(args)
    };
    AddDropPanel.prototype = {
        init: function(args) {
            var self = this;
            if (args["panelToShow"] != undefined)
                this.panelToShow = args["panelToShow"];
            this.leagueId = args["leagueId"];
            this.sport = args["sport"];
            this.numPendingAddDrops = args["numPendingAddDrops"];
            this.leagueUsesWaivers = args["leagueUsesWaivers"];
            this.leagueAddDropPolicy = args["leagueAddDropPolicy"];
            var windowHeight = $(window).height();
            $(".addDropPanelContentContainer").css("height", parseInt(windowHeight - this.openOffset - this.getSkyboxHeight()));
            var openPanel = 0;
            if (args["shouldDisable"]) {
                this.shouldDisable = args["shouldDisable"]
            }
            if (args["disabledMessage"]) {
                this.disabledMessage = args["disabledMessage"]
            }
            if (args["playerToAddId"]) {
                var components = args["playerToAddId"].split(":");
                this.playerToAddPos = components[0];
                this.playerToAddId = components[1];
                openPanel = 1;
                this.defaultAddPlayer = 1
            }
            if (args["playerToDropId"]) {
                this.playerToDropId = args["playerToDropId"];
                openPanel = 1
            }
            if (args["openPanel"] == "pending")
                openPanel = "pending";
            if (openPanel == 1) {
                this.panelToShow = "transactionDetails";
                this.showPanelContents("transactionDetails")
            } else if (openPanel == "pending") {
                this.panelToShow = "pendingAddDrops";
                this.showPanelContents("pendingAddDrops")
            }
            if (args["accessToken"]) {
                this.accessToken = args["accessToken"]
            }
            if (args["initialAlertMessage"]) {
                this.initialAlertMessage = args["initialAlertMessage"];
                this.insertInitialAlertMessage()
            }
            this.containerZIndex = $("div.addDropPanelContainer").zIndex();
            if (this.shouldDisable) {
                this.showDisabledDialog()
            }
            $(window).resize(function() {
                self.recalculateHeights()
            });
            return
        },
        getSkyboxHeight: function() {
            var skyboxHeight = $('.ad-skybox-top iframe[id*="google_ads_iframe"]').outerHeight() || 0;
            return skyboxHeight
        },
        showDisabledDialog: function() {
            var self = this;
            $("#disabledAddDropDialog").dialog({
                dialogClass: "confirm-dialog-sm",
                height: "auto",
                modal: true,
                draggable: false,
                width: "auto",
                zIndex: parseInt(self.containerZIndex + 1),
                buttons: {
                    Ok: function() {
                        $(this).dialog("close")
                    }
                }
            })
        },
        insertInitialAlertMessage: function() {
            var self = this;
            $("#initialAlertMessage").append(self.initialAlertMessage)
        },
        isPanelOpen: function() {
            if ($(".addDropPanelContentContainer").css("display") == "block") {
                return 1
            }
            return 0
        },
        isRosterOpen: function() {
            if ($(".myRosterContainer").css("display") == "block") {
                return 1
            }
            return 0
        },
        clearTo: function() {
            this.playerToAddId = "";
            this.requestStats();
            this.showPanelContents();
            return
        },
        clearFrom: function() {
            this.playerToDropId = "";
            this.requestStats();
            return
        },
        clearFaabBid: function() {
            if ($("#faab_bid_amount")[0]) {
                $("#faab_bid_amount").val("")
            }
        },
        setPrimaryTab: function(tab, transid, queryParams) {
            this.primaryTab = tab;
            this.secondaryTab = "";
            this.sourceId = "";
            this.requestStats(queryParams);
            return false
        },
        setSecondaryTab: function(url, transid, queryParams) {
            var items = url.split("/");
            this.secondaryTab = items[items.length - 1];
            this.requestStats(queryParams);
            return false
        },
        setSecondaryTabSource: function(url, queryParams) {
            var items = url.split("/");
            this.sourceId = items[items.length - 1];
            this.secondaryTab = items[items.length - 1];
            this.requestStats(queryParams);
            return false
        },
        requestStats: function(queryParams) {
            var requestUrl = "/add-drop-panel/transaction-details-panel"
              , params = ""
              , self = this
              , waldoParams = {
                version: "3.0",
                access_token: this.accessToken
            };
            if (typeof queryParams == "undefined") {
                queryParams = []
            }
            if (this.primaryTab) {
                queryParams.push("primaryTab=" + this.primaryTab)
            }
            if (this.secondaryTab) {
                queryParams.push("secondaryTab=" + this.secondaryTab)
            }
            if (this.playerToAddId) {
                queryParams.push("add_player_id=" + this.playerToAddId);
                waldoParams["add_player_id"] = this.playerToAddId
            }
            if (this.playerToDropId) {
                queryParams.push("drop_player_id=" + this.playerToDropId);
                waldoParams["drop_player_id"] = this.playerToDropId
            }
            if (this.dropAction) {
                queryParams.push("drop_action=" + this.dropAction)
            }
            if (this.sourceId) {
                queryParams.push("source_id=" + this.sourceId)
            }
            if (queryParams.length) {
                requestUrl += "?" + queryParams.join("&")
            }
            if (this.loadTransactionDetailsInBackground != 1)
                $(".transactionCompareContainer").fadeTo("1", "0.2");
            $.ajax({
                url: requestUrl,
                success: function(data) {
                    $(".transactionCompareContainer").html(data);
                    if (self.loadTransactionDetailsInBackground != 1)
                        $(".transactionCompareContainer").fadeTo("1", "1");
                    self.loadTransactionDetailsInBackground = 0;
                    $(".tooltip").tooltip()
                },
                error: function(data) {
                    if (self.loadTransactionDetailsInBackground != 1)
                        $(".transactionCompareContainer").fadeTo("1", "1");
                    self.loadTransactionDetailsInBackground = 0
                }
            });
            if (waldoParams.add_player_id || waldoParams.drop_player_id) {
                var messageResponse = Waldo.retrieve({
                    uri: "/api/league/transactions/add-drop-effective-message",
                    uriAlias: "add_drop_effective_msg",
                    params: waldoParams,
                    callback: {
                        success: function() {
                            var result = this
                              , data = result.data();
                            if (data.msg) {
                                $(".transactionProcessMessage").html(data.msg)
                            }
                            self.setTransactionMsg(data)
                        },
                        failure: function() {
                            var result = this
                              , exceptions = result.exceptions();
                            if (exceptions != null && exceptions.length) {
                                for (var x = 0, len = exceptions.length; x < len; x++) {
                                    alert(exceptions[x].msg)
                                }
                            }
                        }
                    }
                })
            } else {
                $(".transactionProcessMessage").html("")
            }
            return
        },
        showRoster: function(forceRefresh) {
            var self = this;
            if (self.isPanelOpen() == 1 && (self.isRosterOpen() == 1 && forceRefresh != 1))
                return;
            $(".myRosterContainer").css("display", "block");
            if (self.isRosterShown == 1 && forceRefresh != 1)
                return;
            var queryParams = "";
            var queryDelimiter = "?";
            if (this.playerToAddId) {
                queryParams = "?add_player_id=" + this.playerToAddId;
                queryDelimiter = "&"
            }
            if (this.playerToDropId) {
                queryParams += queryDelimiter + "drop_player_id=" + this.playerToDropId
            }
            $(".myRosterContainer").fadeTo("1", "0.2");
            $.ajax({
                type: "GET",
                url: "/add-drop-panel/roster-for-add-drop-panel" + queryParams,
                success: function(data) {
                    $(".myRosterContainer").fadeTo("1", "1");
                    $(".myRosterContainer").html(data);
                    self.isRosterShown = 1
                },
                error: function(data) {
                    $(".myRosterContainer").fadeTo("1", "1");
                    self.showError()
                },
                dataType: "html"
            });
            return
        },
        hideRoster: function(forceHideRoster) {
            var self = this;
            if (this.isRosterOpen() == 1 || forceHideRoster == 1) {
                $(".myRosterContainer").css("display", "none");
                if (forceHideRoster != 1)
                    forceHideRoster = 0;
                this.isRosterShown = 0
            }
            return
        },
        handleSubmitResult: function(result) {
            var self = this;
            if (result.statusCode == 204) {
                $("#submittedAddDrop").text("Your transaction has been processed successfully!");
                $("#submittedAddDropDialog").dialog({
                    dialogClass: "confirm-dialog-sm",
                    height: "auto",
                    modal: true,
                    draggable: false,
                    width: "auto",
                    zIndex: parseInt(self.containerZIndex + 1),
                    beforeClose: function(event, ui) {
                        window.location = "/teams?source=add-drop"
                    },
                    buttons: {
                        Ok: function() {
                            $(this).dialog("close")
                        }
                    }
                })
            } else if (result.statusCode == 201) {
                if (self.leagueUsesWaivers == 1) {
                    self.alreadyLoadedPendingAddDrops = 0;
                    self.panelToShow = "";
                    self.loadTransactionDetailsInBackground = 1;
                    self.updateNumPendingAddDrops();
                    if (self.numPendingAddDrops > 1)
                        self.showPanelContents("pendingAddDrops");
                    else
                        self.toggleAddDropPanel()
                }
                self.alreadyLoadedTransactionDetails = 0;
                self.cancelAddDrop();
                var confirmationText = "Your transaction has been processed successfully!";
                if (self.leagueAddDropPolicy.match(/waivers/) != null && self.leagueAddDropPolicy.match(/waivers/).length) {
                    confirmationText = "Your waiver request has been added to your pending transactions"
                } else if (self.leagueAddDropPolicy.match(/faab/) != null && self.leagueAddDropPolicy.match(/faab/).length) {
                    confirmationText = "Your FAB request has been added to your pending transactions"
                } else if (self.leagueAddDropPolicy.match(/approve/) != null && self.leagueAddDropPolicy.match(/approve/).length) {
                    confirmationText = "Your add/drop request has been sent to your commissioner for approval"
                }
                $("#submittedAddDrop").text(confirmationText);
                $("#submittedAddDropDialog").dialog({
                    dialogClass: "confirm-dialog-sm",
                    height: "auto",
                    modal: true,
                    draggable: false,
                    width: "auto",
                    zIndex: parseInt(self.containerZIndex + 1),
                    buttons: {
                        Ok: function() {
                            $(this).dialog("close")
                        }
                    }
                })
            }
        },
        submitAddDrop: function() {
            var self = this;
            document.getElementById("submit").disabled = true;
            var params = {
                access_token: self.accessToken,
                add_player_id: self.playerToAddId,
                drop_player_id: self.playerToDropId,
                action: self.dropAction
            };
            if ($("#comment").val()) {
                params.comment = $("#comment").val()
            }
            if ($("#state").is(":checked")) {
                params.state = "claim"
            }
            if ($("#move_to_top").is(":checked")) {
                params.move_to_top = "1"
            }
            if ($("#faab_bid_amount")[0]) {
                params.faab_bid_amount = $("#faab_bid_amount").val()
            }
            $("#warningDiv").hide({
                complete: function() {
                    $("div.transactionDetailsContainer").css("max-height", parseInt($(".addDropPanelContentContainer").height() - $("div.transactionDetailsButtons").height() - 21))
                }
            });
            setTimeout(function() {
                document.getElementById("submit").disabled = false
            }, 2e3);
            var response = Waldo.retrieve({
                uri: "/api/league/transactions/add-drop",
                uriAlias: "addDrop",
                params: {
                    version: "3.0",
                    payload: JSON.stringify(params),
                    access_token: self.accessToken
                },
                type: "POST",
                callback: {
                    success: function() {
                        var result = this;
                        if (self.editAddDrop != 0) {
                            self.deleteAddDrop(self.editAddDrop, result)
                        } else {
                            self.handleSubmitResult(result)
                        }
                    },
                    failure: function() {
                        var result = this;
                        if (result.statusCode == 400) {
                            $.each(result["_content"]["exceptions"], function(k, v) {
                                $(".warningText").append("<p>" + v["msg"] + "</p>")
                            });
                            $("#warningDiv").show({
                                complete: function() {
                                    $("div.transactionDetailsContainer").css("max-height", parseInt($(".addDropPanelContentContainer").height() - $("div.transactionDetailsButtons").height() - 21))
                                }
                            })
                        }
                    }
                }
            });
            return
        },
        updateNumPendingAddDrops: function() {
            var self = this;
            $.ajax({
                url: "/add-drop-panel/update-num-transactions",
                async: false,
                success: function(data) {
                    var numPendingAddDrops = data.replace(/(\d+).*/, "$1");
                    self.numPendingAddDrops = numPendingAddDrops;
                    $(".numPendingAddDropsCircle").html(numPendingAddDrops)
                }
            });
            return
        },
        cancelAddDrop: function() {
            this.playerToAddId = "";
            this.playerToDropId = "";
            this.defaultAddPlayer = 0;
            if ($("#comment").val()) {
                $("#comment").val("")
            }
            if ($("#state").is(":checked")) {
                $("#state").attr("checked", false)
            }
            if ($("#faab_bid_amount")[0]) {
                $("#faab_bid_amount").val("")
            }
            this.requestStats();
            this.hideRoster();
            return
        },
        showTransactionDetails: function() {
            var self = this;
            $(".pendingAddDropsContainer").css("display", "none");
            $(".transactionCompareContainer").css("display", "block");
            $(".transactionDetailsButtons").css("opacity", 0);
            if ($(".transactionDetailsTitle").hasClass("activeTab") == 0)
                $(".transactionDetailsTitle").addClass("activeTab");
            $(".transactionDetailsTitle").removeClass("inactiveTab");
            $(".pendingAddDropsTitle").removeClass("activeTab");
            if ($(".pendingAddDropsTitle").hasClass("inactiveTab") == 0)
                $(".pendingAddDropsTitle").addClass("inactiveTab");
            var detailsHeight = self.getHeightForPanel();
            $(".addDropPanelContentContainer").animate({
                height: detailsHeight
            }, {
                duration: "slow",
                complete: function() {
                    $("div.transactionDetailsContainer").css("max-height", parseInt($(".addDropPanelContentContainer").height() - $("div.transactionDetailsButtons").height() - 21));
                    $(".transactionDetailsButtons").css("display", "block");
                    if ($("#row_faab_bid_amount").length) {
                        $("#table_form").css({
                            width: "75%",
                            display: "flex",
                            "justify-content": "flex-start"
                        })
                    }
                    $(".transactionDetailsButtons").animate({
                        opacity: 1
                    }, "fast");
                    $("div#tempAddDropPanel").remove()
                }
            });
            self.showRoster();
            var queryParams = [];
            if (self.playerToAddId)
                queryParams.push("add_player_id=" + self.playerToAddId);
            if (self.playerToDropId)
                queryParams.push("drop_player_id=" + self.playerToDropId);
            if (self.dropAction)
                queryParams.push("drop_action=" + self.dropAction);
            $.ajax({
                type: "GET",
                url: "/add-drop-panel/transaction-details-buttons?" + queryParams.join("&"),
                success: function(data) {
                    $(".transactionDetailsButtons").html(data);
                    self.haveButtonsLoaded = 1;
                    if (self.shouldShowFaabBudgetField()) {
                        self.showFaabBidAmount()
                    } else {
                        self.hideFaabBidAmount()
                    }
                    if (self.disabledMessage != "") {
                        self.playerToAddId = undefined;
                        $(".transactionDetailsButtons").html('<div class="disabledAddDropMessageCont"><div class="disabledAddDropMessage">' + self.disabledMessage + "</div></div>");
                        return
                    }
                },
                error: function(data) {
                    self.showError()
                },
                dataType: "html"
            });
            var paramsForTransactions = {
                add_id: self.playerToAddId,
                drop_id: self.playerToDropId,
                state: self.dropState,
                action: self.dropAction,
                bid_amount: self.bidAmount,
                comment: self.comment,
                add_drop_id: self.addDropTransId
            };
            var queryParams = [];
            if (self.playerToAddId)
                queryParams.push("add_player_id=" + self.playerToAddId);
            if (self.playerToDropId)
                queryParams.push("drop_player_id=" + self.playerToDropId);
            if (self.dropState)
                queryParams.push("state=" + self.dropState);
            if (self.dropAction)
                queryParams.push("action=" + self.dropAction);
            if (self.bidAmount)
                queryParams.push("bid_amount=" + self.bidAmount);
            if (self.addDropTransId)
                queryParams.push("add_drop_id=" + self.addDropTransId);
            if (self.playerToAddPos)
                queryParams.push("add_pos=" + self.playerToAddPos);
            if (self.addDropTransId)
                queryParams.push("add_drop_id=" + self.addDropTransId);
            if (self.alreadyLoadedTransactionDetails == 0) {
                $.ajax({
                    type: "GET",
                    url: "/add-drop-panel/transaction-details-panel?" + queryParams.join("&"),
                    success: function(data) {
                        $(".transactionCompareContainer").html(data);
                        self.alreadyLoadedTransactionDetails = 1
                    },
                    error: function(data) {
                        self.showError()
                    },
                    dataType: "html"
                })
            }
            return
        },
        showFaabBidAmount: function() {
            if ($("#row_faab_bid_amount")[0]) {
                $("#row_faab_bid_amount").show()
            }
        },
        hideFaabBidAmount: function() {
            if ($("#row_faab_bid_amount")[0]) {
                $("#row_faab_bid_amount").hide();
                this.clearFaabBid()
            }
        },
        selectPlayerToAdd: function(player) {
            var playerId = player.id.split("_")[1];
            this.playerToAddId = playerId;
            this.showRoster();
            this.showPanelContents("transactionDetails");
            this.requestStats();
            if (self.shouldShowFaabBudgetField()) {
                self.showFaabBidAmount()
            } else {
                self.hideFaabBidAmount()
            }
        },
        selectPlayerToDrop: function(playerId, action) {
            var self = this;
            this.playerToDropId = playerId;
            this.dropAction = action;
            this.requestStats();
            $(".addDropPanelContentContainer").animate({
                scrollTop: $(this).offset
            }, 800);
            $(".transactionDetailsContainer").scrollTop(0);
            return
        },
        shouldShowFaabBudgetField: function() {
            if (this.leagueAddDropPolicy.match(/faab/) != null && this.leagueAddDropPolicy.match(/faab/).length) {
                return this.playerToAddId != ""
            }
            return false
        },
        hideOrShowPendingAddDrops: function() {
            var self = this;
            $.ajax({
                url: "/add-drop-panel/update-num-transactions?want_all_transactions=1",
                success: function(data) {
                    self.updateNumPendingAddDrops();
                    var totalNumPending = data.replace(/(\d+).*/, "$1");
                    if (totalNumPending == 0) {
                        self.alreadyLoadedPendingAddDrops = 0;
                        self.panelToShow = "";
                        self.showPanelContents("pendingAddDrops");
                        self.showPanelContents();
                        return
                    }
                    self.alreadyLoadedPendingAddDrops = 0;
                    self.panelToShow = "";
                    self.showPanelContents("pendingAddDrops")
                }
            });
            return
        },
        showPendingAddDrops: function() {
            var self = this;
            setTimeout(function() {
                var pendingHeight = self.getHeightForPanel();
                $(".addDropPanelContentContainer").animate({
                    height: pendingHeight
                }, {
                    duration: "slow",
                    complete: function() {
                        $("div#tempAddDropPanel").remove()
                    }
                });
                $(".transactionCompareContainer").css("display", "none");
                $(".transactionDetailsButtons").css("display", "none");
                self.hideRoster(1);
                $(".pendingAddDropsContainer").css("display", "block")
            }, 0);
            if ($(".pendingAddDropsTitle").hasClass("activeTab") == 0)
                $(".pendingAddDropsTitle").addClass("activeTab");
            $(".pendingAddDropsTitle").removeClass("inactiveTab");
            if ($(".transactionDetailsTitle").hasClass("inactiveTab") == 0)
                $(".transactionDetailsTitle").addClass("inactiveTab");
            $(".transactionDetailsTitle").removeClass("activeTab");
            if (self.alreadyLoadedPendingAddDrops == 0) {
                $.ajax({
                    type: "GET",
                    url: "/add-drop-panel/pending-transactions-panel",
                    success: function(data) {
                        $(".pendingAddDropsContainer").html(data);
                        self.alreadyLoadedPendingAddDrops = 1
                    },
                    error: function(data) {
                        self.showError()
                    },
                    dataType: "html"
                })
            }
            return
        },
        deleteAddDrop: function(transactionId, result) {
            var self = this;
            if (transactionId != "") {
                var params = {
                    version: "3.0",
                    access_token: self.accessToken,
                    id: transactionId
                };
                var deleteResponse = Waldo.retrieve({
                    uri: "/api/league/transactions/add-drop",
                    uriAlias: "delete_add_drop",
                    params: params,
                    type: "DELETE",
                    callback: {
                        success: function() {
                            if (self.editAddDrop != 0) {
                                self.editAddDrop = 0;
                                self.handleSubmitResult(result);
                                return
                            }
                            self.hideOrShowPendingAddDrops()
                        },
                        failure: function() {
                            var result = this
                              , exceptions = result.exceptions();
                            if (exceptions != null && exceptions.length) {
                                for (var x = 0, len = exceptions.length; x < len; x++) {
                                    alert(exceptions[x].msg)
                                }
                            }
                        }
                    }
                })
            }
            return
        },
        moveAddDrop: function(transactionId, direction) {
            var self = this;
            if (direction == undefined || transactionId == undefined || transactionId == "")
                return;
            var payloadData = {
                id: transactionId,
                action: "move",
                direction: direction
            };
            if (transactionId != "") {
                var params = {
                    version: "3.0",
                    access_token: self.accessToken,
                    payload: JSON.stringify(payloadData)
                };
                var moveResponse = Waldo.retrieve({
                    uri: "/api/league/transactions/add-drop",
                    uriAlias: "move_add_drop",
                    params: params,
                    type: "PUT",
                    callback: {
                        success: function() {
                            self.alreadyLoadedPendingAddDrops = 0;
                            self.panelToShow = "";
                            self.showPanelContents("pendingAddDrops")
                        },
                        failure: function() {
                            var result = this
                              , exceptions = result.exceptions();
                            if (exceptions != null && exceptions.length) {
                                for (var x = 0, len = exceptions.length; x < len; x++) {
                                    alert(exceptions[x].msg)
                                }
                            }
                        }
                    }
                })
            }
            return
        },
        editTransaction: function(transactionId) {
            var self = this;
            if (transactionId == undefined || transactionId == "")
                return;
            if (self.shouldDisable == 1)
                return;
            var params = {
                version: "3.0",
                access_token: self.accessToken,
                id: transactionId
            };
            var getResponse = Waldo.retrieve({
                uri: "/api/league/transactions/add-drop",
                uriAlias: "get_add_drop",
                params: params,
                type: "GET",
                callback: {
                    success: function() {
                        var addDrop = this.data()["add_drop"];
                        self.playerToAddId = addDrop["add_players"] ? addDrop["add_players"][0]["id"] : "";
                        self.playerToDropId = addDrop["drop_players"] ? addDrop["drop_players"][0]["id"] : "";
                        self.bidAmount = addDrop["bid_amount"];
                        self.comment = addDrop["comment"];
                        self.dropAction = addDrop["action"];
                        self.dropState = addDrop["state"];
                        if (addDrop["comment"]) {
                            $("#comment").val(addDrop["comment"])
                        }
                        if (addDrop["action"] == "claim") {
                            $("#state").prop("checked", true)
                        }
                        if (addDrop["bid_amount"]) {
                            $("#faab_bid_amount").val(addDrop["bid_amount"])
                        }
                        self.editAddDrop = transactionId;
                        self.alreadyLoadedTransactionDetails = 0;
                        self.showPanelContents("transactionDetails")
                    },
                    failure: function() {
                        var result = this
                          , exceptions = result.exceptions();
                        if (exceptions != null && exceptions.length) {
                            for (var x = 0, len = exceptions.length; x < len; x++) {
                                alert(exceptions[x].msg)
                            }
                        }
                    }
                }
            });
            return
        },
        showPanelContents: function(panelToShow) {
            if (this.panelToShow == panelToShow && this.isPanelOpen() == 1)
                return;
            if (panelToShow != "" && panelToShow != undefined) {
                this.panelToShow = panelToShow
            }
            if (this.isPanelOpen() == 0 || this.isPanelOpen() == 1 && panelToShow == undefined) {
                this.toggleAddDropPanel()
            }
            this.showPanel();
            return
        },
        setTransactionMsg: function(args) {
            if (args.effective_point) {
                this.effective_point = args.effective_point
            }
            if (args.effective_period) {
                this.effecitve_period = args.effective_period
            }
            if (args.msg) {
                this.transactionMsg = args.msg
            }
            if (args.default_waiver_msg) {
                this.defaultWaiverMsg = args.default_waiver_msg
            }
            if (args.default_waiver_date) {
                this.defaultWaiverDate = args.default_waiver_date
            }
            if (args.player_waiver_date) {
                this.playerWaiverDate = args.player_waiver_date
            }
        },
        setDefaultWaiverMsg: function(checked) {
            if (checked) {
                if (this.defaultWaiverDate && (this.playerWaiverDate && this.defaultWaiverDate > this.playerWaiverDate) || !this.playerWaiverDate) {
                    $(".transactionProcessMessage").html(this.defaultWaiverMsg)
                }
            } else {
                $(".transactionProcessMessage").html(this.transactionMsg)
            }
        },
        showPanel: function() {
            if (this.panelToShow == "transactionDetails") {
                this.showTransactionDetails();
                $(".transactionDetailsTitle").addClass("activeTab");
                $(".transactionDetailsTitle").removeClass("inactiveTab")
            } else {
                this.showPendingAddDrops();
                $(".pendingAddDropsTitle").addClass("activeTab");
                $(".pendingAddDropsTitle").removeClass("inactiveTab")
            }
            return
        },
        toggleAddDropPanel: function() {
            var self = this;
            if (self.isPanelOpen() == 0) {} else {
                $(".transactionDetailsButtons").animate({
                    opacity: 0
                }, "fast")
            }
            $(".addDropPanelContentContainer").slideToggle({
                duration: "slow",
                queue: true,
                complete: function() {
                    window.scrollTo(0, 0);
                    if (self.isPanelOpen() == 1)
                        self.disableScrolling();
                    else
                        self.enableScrolling();
                    if (self.isPanelOpen() == 0) {
                        $(".openAndCloseImg").removeClass("close");
                        $(".openAndCloseImg").addClass("open");
                        $(".addDropPanelContentContainer").height(0)
                    } else if (self.isPanelOpen() == 1) {
                        $(".openAndCloseImg").removeClass("open");
                        $(".openAndCloseImg").addClass("close")
                    }
                    self.isRosterShown = 0
                }
            });
            return
        },
        disableScrolling: function() {
            var self = this;
            var scrollPosition = [self.pageXOffset || document.documentElement.scrollLeft || document.body.scrollLeft, self.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop];
            var html = jQuery("html");
            html.data("scroll-position", scrollPosition);
            html.data("previous-overflow", html.css("overflow"));
            html.css("overflow", "hidden");
            window.scrollTo(scrollPosition[0], scrollPosition[1])
        },
        enableScrolling: function() {
            var html = jQuery("html");
            var scrollPosition = html.data("scroll-position");
            html.css("overflow", html.data("previous-overflow"));
            window.scrollTo(scrollPosition[0], scrollPosition[1])
        },
        getHeightForPanel: function() {
            var windowHeight = $(window).height();
            if (this.panelToShow == "transactionDetails") {
                var transactionButtonsHeight = $("div.transactionDetailsButtons").height();
                return parseInt(windowHeight - this.openOffset - this.getSkyboxHeight())
            } else {
                return parseInt(windowHeight - this.openOffset - 100 - this.getSkyboxHeight())
            }
        },
        recalculateHeights: function() {
            var self = this;
            if (this.panelToShow == "transactionDetails") {
                var windowHeight = $(window).height();
                $(".addDropPanelContentContainer").css("height", parseInt(windowHeight - this.openOffset));
                $("div.transactionDetailsContainer").css("max-height", parseInt($(".addDropPanelContentContainer").height() - $("div.transactionDetailsButtons").height() - 21))
            } else {
                var pendingHeight = self.getHeightForPanel();
                $(".addDropPanelContentContainer").height(pendingHeight)
            }
        },
        showError: function() {
            alert("ERROR");
            return
        }
    };
</script>
