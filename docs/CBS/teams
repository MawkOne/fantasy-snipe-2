    function gambling_tracking_impressions(isFullPageLoad) {
        var trackTitle = '';
        var trackImpressionObj = {};
        $('a.william-hill-link').each(function() {
            var trackImpression = $(this).data('wh-tracking-impression');
            if (trackImpression) {
                if (typeof utag_data !== "undefined" && typeof trackImpression.moduleLocation !== "undefined" && trackImpression.moduleLocation == 'pageName') {
                    trackImpression.moduleLocation = utag_data.pageName;
                }
                if (isFullPageLoad || trackImpression.moduleName != 'cbs-network-bar') {
                    if (trackTitle == '') {
                        trackTitle = trackImpression.moduleName;
                        trackImpressionObj = JSON.parse(JSON.stringify(trackImpression));
                        // don't add duplicates
                    } else if (trackTitle.indexOf(trackImpression.moduleName) == -1) {
                        trackTitle += ";" + trackImpression.moduleName;
                        trackImpressionObj.moduleName += ";" + trackImpression.moduleName;
                    }
                }
            }
        });
        if (trackTitle != '' && typeof om !== "undefined") {
            om.trackAction(trackTitle, trackImpressionObj);
            if (typeof utag_data !== "undefined") {
