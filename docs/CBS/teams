            if (oneByOneUrl && !trackingImage) {
                var timestamp = Date.now() || +new Date();
                var replacementObj = {
                    "#vguid#": surround.vguid,
                    "#timestamp#": timestamp
                };
                oneByOneUrl = oneByOneUrl.replace(/#vguid#|#VGUID#|#timestamp#|#TIMESTAMP#/gi, function(match) {
                    return replacementObj[match.toLowerCase()];
                });
                trackingImage = '<img src=' + oneByOneUrl + ' style="height: 1px; width: 1px;" border="0" alt="Advertisement" >';
                $('body').append(trackingImage);
            }
        });
