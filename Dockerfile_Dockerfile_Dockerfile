# Use official lightweight Python image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies (for psycopg2)
RUN apt-get update && apt-get install -y libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy ETL code
COPY nhl_edge/etl_pipeline.py .
# Create directory structure needed by the script
RUN mkdir -p nhl_edge/game_data

# Set entrypoint
# We will pass GAME_ID as an argument when running the container
ENTRYPOINT ["python", "etl_pipeline.py"]

